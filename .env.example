# Opción sencilla compatible con v1: una única maestra, identificada como KEY01.
# Generar localmente una clave Base64 de 32 bytes. Nunca subir secretos reales.
MODSEC_CLAVE=

# Para varias maestras históricas (una por generación, no una por operación):
# Quitar MODSEC_CLAVE vacío si se migra a la configuración de múltiples claves.
# MODSEC_CLAVE_ACTIVA=KEY02
# MODSEC_CLAVE_KEY01=
# MODSEC_CLAVE_KEY02=
# Conservar KEY01 mientras existan datos o archivos que dependan de ella.
